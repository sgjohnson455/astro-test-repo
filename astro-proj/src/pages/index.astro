---
import '../styles/global.css';
import SiteHeader from "../components/SiteHeader.astro";
import Hero from "../components/Hero.astro";
import SectionIntro from "../components/SectionIntro.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import FeatureRow from "../components/FeatureRow.astro";
import SpeakingSection from "../components/SpeakingSection.astro";
import SiteFooter from "../components/SiteFooter.astro";

const transitProjects = [
  { title: "GTFS Pulisher", href: "/work/gtfs-publisher", span: "wide" as const },
  { title: "Timetable Evolution", href: "/work/timetable-evolution", span: "narrow" as const },
  { title: "Timetable Evolution", href: "/work/timetable-evolution", span: "narrow" as const },
  { title: "GTFS Pulisher", href: "/work/gtfs-publisher", span: "wide" as const },
];

const transitProjectsRepeat = [
  { title: "GTFS Pulisher", href: "/work/gtfs-publisher", span: "wide" as const },
  { title: "Timetable Evolution", href: "/work/timetable-evolution", span: "narrow" as const },
];

const neighborhoodFeatures = [
  {
    title: "The neighborhood app",
    description: "Led the research and design of an integrated real estate evaluation and comparison tool",
  },
  {
    title: "The neighborhood app",
    description: "Created localized landing page for a crypto client and designed a learning game for an education webapp",
  },
  {
    title: "The neighborhood app",
    description: "Led the research and design of an integrated real estate evaluation and comparison tool",
  },
];

const talks = [
  {
    label: "TALK",
    title: "Designing for Public Transit Planning",
    meta: "Service Design Drinks Berlin & Berlin Product Designers Meetup \u00b7 November 2025",
  },
  {
    label: "PRESENTATION",
    title: "Design Lessons from Public Transit Planners",
    meta: "Service Design Jam Berlin \u00b7 November 2024",
  },
  {
    label: "PRESENTATION",
    title: "Design Lessons from Public Transit Planners",
    meta: "Service Design Jam Berlin \u00b7 November 2024",
  },
  {
    label: "PRESENTATION",
    title: "Design Lessons from Public Transit Planners",
    meta: "Service Design Jam Berlin \u00b7 November 2024",
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sara Johnson &mdash; UX Designer</title>
  </head>
  <body class="bg-white">
    <SiteHeader />

    <main>
      <Hero />

      <SectionIntro
        title="Industry-leading public transit planning suite"
        subtitle="Design, Research, and Strategy"
      />
      <ProjectGrid projects={transitProjects} />

      <div class="mt-20 md:mt-28">
        <SectionIntro
          title="Industry-leading public transit planning suite"
          subtitle="Design, Research, and Strategy"
        />
        <ProjectGrid projects={transitProjectsRepeat} />
      </div>

      <FeatureRow features={neighborhoodFeatures} />

      <SpeakingSection talks={talks} />
    </main>

    <SiteFooter />
  </body>
</html>