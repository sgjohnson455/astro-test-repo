---
interface Props {
  title: string;
  href?: string;
  image?: string;
  class?: string;
}

const { title, href = "#", image, class: className = "" } = Astro.props;
---

<a
  href={href}
  class:list={[
    "group relative block aspect-[4/5] overflow-hidden rounded-2xl bg-black",
    className,
  ]}
>
  {image && (
    <img
      src={image}
      alt=""
      class="absolute inset-0 h-full w-full object-cover opacity-80 transition-opacity group-hover:opacity-95"
    />
  )}
  <div class="relative z-10 flex h-full flex-col justify-start p-6 md:p-7">
    <h3 class="text-lg font-bold text-white md:text-xl">{title}</h3>
    <span
      class="mt-2 inline-block w-fit text-white transition-transform group-hover:translate-x-1"
      aria-hidden="true"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M5 12h14M13 6l6 6-6 6"></path>
      </svg>
    </span>
  </div>
</a>