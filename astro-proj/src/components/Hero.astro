---
interface Props {
  name?: string;
  description?: string;
}

const {
  name = "Sara Johnson",
  description = "I\u2019m a UX designer who brings intuitive, accessible, and empathetic designs to people.",
} = Astro.props;
---

<section
  class="mx-auto px-6 pt-16 pb-16 md:px-64 md:pt-16 md:pb-10 md:min-h-[580px]"
>
  <h1
    class="text-4xl font-extrabold tracking-tight text-neutral-900 sm:text-5xl md:text-6xl"
  >
    Hi, I&rsquo;m {name}
  </h1>
  <p
    class="mt-3 max-w-2xl text-2xl leading-none text-neutral-900 sm:text-3xl md:text-5xl"
  >
    {description}
  </p>
</section>
