---
import ProjectCard from "./ProjectCard.astro";

interface Project {
  title: string;
  href?: string;
  image?: string;
  span?: "wide" | "narrow";
  bgColor?: string;
}

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;

const spanClass = (span?: Project["span"]) => {
  const isWide = span !== "narrow";
  return [
    "md:col-span-6", // 768–1023px: equal-width boxes
    isWide ? "lg:col-span-8" : "lg:col-span-4", // ≥1024px: balanced 2/3 + 1/3 ratio
  ].join(" ");
};
---

<div
  class="mx-auto mt-10 grid w-full max-w-[1200px] auto-rows-[300px] grid-cols-1 gap-5 px-4 md:mt-12 md:grid-cols-12 md:gap-5 md:px-10 lg:auto-rows-[400px]"
>
  {
    projects.map((project) => (
      <ProjectCard
        title={project.title}
        href={project.href}
        image={project.image}
        bgColor={project.bgColor}
        class={spanClass(project.span)}
      />
    ))
  }
</div>
