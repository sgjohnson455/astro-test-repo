---
import ProjectCard from "./ProjectCard.astro";

interface Project {
  title: string;
  href?: string;
  image?: string;
  /** controls relative width on desktop; alternate these to match the mock's rhythm */
  span?: "wide" | "narrow";
}

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;

const spanClass = (span?: Project["span"]) =>
  span === "narrow" ? "md:col-span-5" : "md:col-span-7";
---

<div class="mt-10 grid grid-cols-1 gap-5 px-6 md:mt-12 md:grid-cols-12 md:gap-6 md:px-10">
  {projects.map((project) => (
    <ProjectCard
      title={project.title}
      href={project.href}
      image={project.image}
      class={spanClass(project.span)}
    />
  ))}
</div>