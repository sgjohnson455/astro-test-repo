---
import FeatureItem from "./FeatureItem.astro";

interface Feature {
  title: string;
  description: string;
}

interface Props {
  features: Feature[];
}

const { features } = Astro.props;
---

<div
  class="mt-16 grid grid-cols-1 divide-y divide-neutral-200 px-6 md:mt-24 md:grid-cols-3 md:divide-x md:divide-y-0 md:px-10"
>
  {features.map((feature) => (
    <FeatureItem title={feature.title} description={feature.description} />
  ))}
</div>