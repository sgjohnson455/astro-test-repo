---
// src/components/Table.astro
interface Props {
    headers: string[];
    rows: (string | number)[][];
    caption?: string;
}

const { headers, rows, caption } = Astro.props;
---

<div class="overflow-x-auto rounded-lg border border-gray-200">
    <table class="w-full text-left text-sm">
        {
            caption && (
                <caption class="p-3 text-left text-sm text-gray-500 bg-gray-50 border-b border-gray-200">
                    {caption}
                </caption>
            )
        }
        <thead class="bg-gray-100">
            <tr>
                {
                    headers.map((header) => (
                        <th class="px-4 py-3 font-semibold text-gray-700 uppercase tracking-wide text-xs">
                            {header}
                        </th>
                    ))
                }
            </tr>
        </thead>
        <tbody>
            {
                rows.map((row, i) => (
                    <tr
                        class={`border-t border-gray-200 ${i % 2 === 0 ? "bg-white" : "bg-gray-50"} hover:bg-gray-100 transition-colors`}
                    >
                        {row.map((cell) => (
                            <td class="px-4 py-3 text-gray-800">{cell}</td>
                        ))}
                    </tr>
                ))
            }
        </tbody>
    </table>
</div>
