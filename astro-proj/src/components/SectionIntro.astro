---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="px-6 md:px-10">
  <span class="mb-4 block h-4 w-16 bg-neutral-800" aria-hidden="true"></span>
  <h2 class="text-2xl font-bold tracking-tight text-neutral-900 md:text-[28px]">
    {title}
  </h2>
  {subtitle && <p class="mt-2 text-base text-neutral-500">{subtitle}</p>}
</div>