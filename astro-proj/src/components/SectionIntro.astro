---
interface Props {
  title: string;
  subtitle?: string;
  logo?: string; // path to a PNG in /public, e.g. "/logos/remix.png"
  logoAlt?: string;
}

const { title, subtitle, logo, logoAlt = "" } = Astro.props;
---

<div
  class="mx-auto w-full max-w-[1200px] px-5 md:px-10 lg:grid lg:grid-cols-12 lg:gap-5"
>
  <div class="lg:col-span-11 lg:col-start-2">
    {
      logo ? (
        <img
          src={logo}
          alt={logoAlt}
          class="mb-2 block h-8 w-auto max-w-none"
        />
      ) : (
        <span class="mb-2 block h-8 w-16 bg-neutral-800" aria-hidden="true" />
      )
    }
    <h2 class="text-2xl font-bold tracking-tight text-neutral-900 text-[30px]">
      {title}
    </h2>
    {
      subtitle && (
        <p class="mt-2 text-base text-neutral-500 text-[20px]">{subtitle}</p>
      )
    }
  </div>
</div>
