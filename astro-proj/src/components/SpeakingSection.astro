---
import SpeakingItem from "./SpeakingItem.astro";

interface Talk {
  label: string;
  title: string;
  meta: string;
}

interface Props {
  heading?: string;
  talks: Talk[];
}

const { heading = "Community & Speaking", talks } = Astro.props;
const [firstWord, ...rest] = heading.split(" ");
---

<section class="mt-24 grid grid-cols-1 gap-8 px-6 md:mt-32 md:grid-cols-[280px_1fr] md:gap-16 md:px-10">
  <h2 class="text-3xl font-extrabold leading-tight text-neutral-900 md:text-4xl">
    {firstWord}
    <br />
    {rest.join(" ")}
  </h2>
  <div class="divide-y divide-neutral-200">
    {talks.map((talk) => (
      <SpeakingItem label={talk.label} title={talk.title} meta={talk.meta} />
    ))}
  </div>
</section>