---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<div class="px-6 py-6 md:px-8 md:py-2">
  <span class="mx-auto mb-4 block h-3.5 w-14 bg-neutral-800" aria-hidden="true"></span>
  <h3 class="text-center text-lg font-bold text-neutral-900">{title}</h3>
  <p class="mx-auto mt-2 max-w-[240px] text-center text-sm leading-relaxed text-neutral-500">
    {description}
  </p>
</div>