---
import Logo from "./Logo.astro";

interface NavLink {
  label: string;
  href: string;
}

interface Props {
  name?: string;
  links?: NavLink[];
}

const {
  name = "Sara",
  links = [
    { label: "Design", href: "/design" },
    { label: "About", href: "/about" },
    { label: "Resume", href: "/resume" },
    { label: "Email", href: "mailto:sgjohnson455@gmail.com" },
  ],
} = Astro.props;
---

<header class="relative px-6 py-6 shadow-sm md:px-10 md:py-8">
  <div class="flex items-center justify-between">
    <Logo name={name} />

    <!-- Desktop nav — unchanged, still hidden below sm, flex row at sm+ -->
    <nav class="hidden items-center gap-8 text-lg text-neutral-900 sm:flex">
      {
        links.map((link) => (
          <a href={link.href} class="transition-opacity hover:opacity-60">
            {link.label}
          </a>
        ))
      }
    </nav>

    <!-- Hamburger button — visible below sm, hidden at sm+ (matches nav's own breakpoint) -->
    <button
      id="menu-toggle"
      class="inline-flex items-center justify-center p-2 text-neutral-900 sm:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg
        id="icon-open"
        xmlns="http://www.w3.org/2000/svg"
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="4" y1="12" x2="20" y2="12"></line>
        <line x1="4" y1="6" x2="20" y2="6"></line>
        <line x1="4" y1="18" x2="20" y2="18"></line>
      </svg>
      <svg
        id="icon-close"
        class="hidden"
        xmlns="http://www.w3.org/2000/svg"
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Mobile dropdown panel — starts hidden, only relevant below sm -->
  <nav
    id="mobile-menu"
    class="hidden flex-col gap-4 text-lg pt-6 text-neutral-900 sm:hidden"
  >
    {
      links.map((link) => (
        <a
          href={link.href}
          class="mobile-link transition-opacity hover:opacity-60"
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</header>

<script>
  const toggleBtn = document.getElementById("menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("icon-open");
  const iconClose = document.getElementById("icon-close");

  function closeMenu() {
    mobileMenu?.classList.add("hidden");
    mobileMenu?.classList.remove("flex");
    iconOpen?.classList.remove("hidden");
    iconClose?.classList.add("hidden");
    toggleBtn?.setAttribute("aria-expanded", "false");
    toggleBtn?.setAttribute("aria-label", "Open menu");
  }

  function openMenu() {
    mobileMenu?.classList.remove("hidden");
    mobileMenu?.classList.add("flex");
    iconOpen?.classList.add("hidden");
    iconClose?.classList.remove("hidden");
    toggleBtn?.setAttribute("aria-expanded", "true");
    toggleBtn?.setAttribute("aria-label", "Close menu");
  }

  toggleBtn?.addEventListener("click", () => {
    const isOpen = !mobileMenu?.classList.contains("hidden");
    isOpen ? closeMenu() : openMenu();
  });

  document.querySelectorAll(".mobile-link").forEach((link) => {
    link.addEventListener("click", closeMenu);
  });
</script>
