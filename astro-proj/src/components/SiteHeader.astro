---
import Logo from "./Logo.astro";

interface NavLink {
  label: string;
  href: string;
}

interface Props {
  name?: string;
  links?: NavLink[];
}

const {
  name = "Sara Johnson",
  links = [
    { label: "Design", href: "/design" },
    { label: "About", href: "/about" },
    { label: "Resume", href: "/resume" },
    { label: "Email", href: "mailto:hello@example.com" },
  ],
} = Astro.props;
---

<header class="flex items-center justify-between px-6 py-6 md:px-10 md:py-8">
  <Logo name={name} />
  <nav class="hidden items-center gap-8 text-[15px] text-neutral-900 sm:flex">
    {links.map((link) => (
      <a href={link.href} class="transition-opacity hover:opacity-60">
        {link.label}
      </a>
    ))}
  </nav>
</header>